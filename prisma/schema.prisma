generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SprintState {
  ACTIVE
  CLOSED
  FUTURE
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

model Team {
  id                  String   @id @default(cuid())
  name                String
  jiraBoardId         String
  syncIntervalMinutes Int      @default(60)
  metricsSince        DateTime?
  /// Jira-Board-Spalten als JSON: [{ name, statuses: string[] }] (Status-Namen)
  boardColumns        String?
  lastSyncedAt        DateTime?
  lastSyncError       String?
  createdAt           DateTime @default(now())
  sprints             Sprint[]
  members             TeamMember[]
  refinements         Refinement[]
}

model Sprint {
  id              String       @id @default(cuid())
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId          String
  jiraSprintId    String
  name            String
  state           SprintState
  startDate       DateTime?
  endDate         DateTime?
  completeDate    DateTime?
  committedPoints Float        @default(0)
  completedPoints Float        @default(0)
  issues          Issue[]
  burndownPoints  BurndownPoint[]
  capacityEntries CapacityEntry[]

  @@unique([teamId, jiraSprintId])
}

model Issue {
  id                   String         @id @default(cuid())
  sprint               Sprint         @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  sprintId             String
  jiraKey              String
  summary              String
  issueType            String         @default("")
  storyPoints          Float          @default(0)
  status               String
  statusCategory       StatusCategory
  resolvedAt           DateTime?
  addedAfterSprintStart Boolean       @default(false)
  /// Sichtbar auf dem Jira-Board (Board-Filter + Spalten-Mapping)
  onBoard              Boolean        @default(true)
  /// Anzeigename des Bearbeiters aus Jira (null = nicht zugewiesen)
  assignee             String?
  /// Zeitpunkt des letzten Status-Wechsels in Jira (null = noch nie gesynct)
  statusSince          DateTime?

  @@unique([sprintId, jiraKey])
}

model BurndownPoint {
  id              String   @id @default(cuid())
  sprint          Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  sprintId        String
  date            DateTime
  remainingPoints Float
  completedPoints Float
  remainingBugs   Int      @default(0)
  remainingTickets Int      @default(0)

  @@unique([sprintId, date])
}

model TeamMember {
  id                String          @id @default(cuid())
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  name              String
  /// Standard-Personentage als Vorbelegung für neue Sprints (null = Sprint-Arbeitstage)
  defaultPersonDays Float?
  capacityEntries   CapacityEntry[]
}

model CapacityEntry {
  id                String      @id @default(cuid())
  sprint            Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  sprintId          String
  teamMember        TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  teamMemberId      String?
  name              String
  plannedPersonDays Float       @default(0)
  actualPersonDays  Float       @default(0)

  @@unique([sprintId, teamMemberId])
}

enum RefinementState {
  DRAFT
  RUNNING
  DONE
}

enum RefinementTicketState {
  PENDING
  VOTING
  REVEALED
  ESTIMATED
}

model Refinement {
  id             String              @id @default(cuid())
  team           Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String
  name           String
  state          RefinementState     @default(DRAFT)
  /// Gerade besprochenes Ticket (null = keines gewählt)
  activeTicketId String?
  createdAt      DateTime            @default(now())
  tickets        RefinementTicket[]
  participants   RefinementParticipant[]
}

model RefinementTicket {
  id             String                @id @default(cuid())
  refinement     Refinement            @relation(fields: [refinementId], references: [id], onDelete: Cascade)
  refinementId   String
  jiraKey        String
  summary        String
  issueType      String                @default("")
  /// Beschreibung aus Jira (gekürzter Klartext) zum Zeitpunkt des Hinzufügens
  description    String                @default("")
  /// Schätzung in Jira zum Zeitpunkt des Hinzufügens (null = unbewertet)
  previousPoints Float?
  position       Int
  state          RefinementTicketState @default(PENDING)
  finalPoints    Float?
  votes          RefinementVote[]

  @@unique([refinementId, jiraKey])
}

model RefinementParticipant {
  id           String           @id @default(cuid())
  refinement   Refinement       @relation(fields: [refinementId], references: [id], onDelete: Cascade)
  refinementId String
  name         String
  /// Emoji-Avatar ("" = keiner gewählt)
  avatar       String           @default("")
  isAdmin      Boolean          @default(false)
  /// Besucher schauen nur zu: kein Sitzplatz, keine Stimme
  isVisitor    Boolean          @default(false)
  /// Geräte-Token (localStorage) zum Wiedererkennen ohne Login
  token        String           @unique @default(cuid())
  /// Letzter Heartbeat (State-Poll) — bestimmt, wer als anwesend gilt
  lastSeenAt   DateTime?
  votes        RefinementVote[]

  @@unique([refinementId, name])
}

model RefinementVote {
  id            String                @id @default(cuid())
  ticket        RefinementTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId      String
  participant   RefinementParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String
  /// null = „?" (unklar)
  points        Float?

  @@unique([ticketId, participantId])
}
